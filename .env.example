# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — your real keys never get committed.
#
# Get a free EIA key (instant): https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Optional: GPT-4o operator briefings. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: ERCOT API (only if you wire up authenticated ERCOT access).
ERCOT_API_KEY=
